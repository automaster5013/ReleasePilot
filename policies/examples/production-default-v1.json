{
  "schemaVersion": "1.0",
  "name": "production-default-v1",
  "description": "ReleasePilot MVP production 기본 Canary 정책",
  "strategy": "CANARY",
  "steps": [
    {
      "weight": 10,
      "minimumObservationSeconds": 300
    },
    {
      "weight": 30,
      "minimumObservationSeconds": 300
    },
    {
      "weight": 60,
      "minimumObservationSeconds": 300
    },
    {
      "weight": 100,
      "minimumObservationSeconds": 300
    }
  ],
  "metrics": [
    {
      "key": "HTTP_5XX_RATE",
      "required": true,
      "comparison": "LESS_THAN",
      "threshold": 0.01,
      "relativeToBaseline": {
        "maximumAbsoluteIncrease": 0.005
      }
    },
    {
      "key": "HTTP_P95_LATENCY_MS",
      "required": true,
      "comparison": "LESS_THAN",
      "threshold": 500,
      "relativeToBaseline": {
        "maximumRelativeIncreasePercent": 20
      }
    },
    {
      "key": "REQUEST_COUNT",
      "required": true,
      "comparison": "GREATER_THAN_OR_EQUAL",
      "threshold": 1000
    }
  ],
  "inconclusivePolicy": {
    "additionalObservationSeconds": 300,
    "maximumAttempts": 2,
    "onExhausted": "PAUSE"
  }
}
